{
  "name": "digital-products",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --test tests/svelte-merge-contract.test.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:check": "pnpm audit && pnpm outdated",
    "start": "vite preview",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/table-core": "^8.21.3",
    "arctic": "^3.7.0",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.1.0",
    "layerchart": "2.8.1",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "stripe": "^23.0.0",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^3.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "pnpm": {
    "overrides": {
      "@sveltejs/vite-plugin-svelte@7.3.1>deepmerge": "npm:@fastify/deepmerge@3.2.4"
    },
    "patchedDependencies": {
      "@sveltejs/vite-plugin-svelte@7.3.1": "patches/@sveltejs__vite-plugin-svelte@7.3.1.patch"
    }
  }
}
