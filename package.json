{
  "name": "digital-products",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --test tests/catalog-identity.test.mjs && node scripts/build-template.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig tests/table-harness/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:check": "pnpm audit && pnpm outdated",
    "start": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "check:table": "svelte-kit sync && svelte-check --tsconfig tests/table-harness/tsconfig.json",
    "build:table-harness": "vite build --config tests/table-harness/vite.config.ts",
    "test:passwords": "node --test tests/password-storage.test.mjs",
    "test:commerce": "node --test tests/commerce-boundary.test.mjs tests/commerce-provider.test.mjs",
    "build:server": "node --test tests/support-articles.test.mjs && node --test tests/template-navigation.test.mjs && node --test tests/commerce-boundary.test.mjs tests/commerce-provider.test.mjs && node --test tests/password-storage.test.mjs && node --test tests/svelte-merge-contract.test.mjs tests/table-contract.test.mjs && vite build"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.66.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@stripe/stripe-js": "^10.2.0",
    "@tanstack/svelte-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "arctic": "^3.7.0",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.1.0",
    "layerchart": "2.9.2",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "stripe": "^23.1.0",
    "svelte-sonner": "^1.2.2",
    "sveltekit-superforms": "^3.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "pnpm": {
    "overrides": {
      "@sveltejs/vite-plugin-svelte@7.3.1>deepmerge": "npm:@fastify/deepmerge@3.2.4",
      "sveltekit-superforms@3.0.0>joi": "17.13.9"
    },
    "patchedDependencies": {
      "@sveltejs/vite-plugin-svelte@7.3.1": "patches/@sveltejs__vite-plugin-svelte@7.3.1.patch"
    }
  },
  "packageManager": "pnpm@10.34.7"
}
